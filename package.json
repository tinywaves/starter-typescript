{
  "name": "starter-typescript",
  "type": "module",
  "version": "1.3.14",
  "packageManager": "pnpm@12.4.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.4.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    }
  },
  "description": "A template for typescript project",
  "author": {
    "name": "tinywaves",
    "email": "dhzhme@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/tinywaves/starter-typescript",
  "keywords": [
    "typescript",
    "template",
    "starter"
  ],
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "repository": {
    "url": "git+https://github.com/tinywaves/starter-typescript.git",
    "type": "git"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "build:dev": "tsdown --watch",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "lint": "eslint",
    "lint-fix": "eslint --fix",
    "prepare": "prek install --hook-type pre-commit --hook-type commit-msg",
    "release": "bumpp",
    "release:publish": "pnpm release && pnpm publish --access public",
    "test": "vitest run",
    "test:coverage": "pnpm run test --coverage",
    "test:dev": "vitest",
    "version:update": "taze major",
    "version:update:w": "taze major -w"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@dhzh/eslint-config": "^2.6.2",
    "@j178/prek": "^0.5.2",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "bumpp": "^12.3.0",
    "changelogithub": "^15.0.5",
    "eslint": "^10.10.0",
    "lint-staged": "^17.5.1",
    "taze": "^21.1.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
